<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>For My Love ❤️</title>

<style>
  body {
    margin: 0;
    font-family: Arial, sans-serif;
    text-align: center;
    background: linear-gradient(-45deg, #ff9a9e, #fad0c4, #ffdde1);
    background-size: 400% 400%;
    animation: gradientBG 10s ease infinite;
    color: white;
    overflow-x: hidden;
  }

  /* INTRO SCREEN */
  #intro {
    position: fixed;
    width: 100%;
    height: 100%;
    background: #ff6b81;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    z-index: 999;
    transition: opacity 1s ease;
  }

  #startBtn {
    padding: 15px 25px;
    font-size: 1.2em;
    border: none;
    border-radius: 25px;
    background: white;
    color: #ff6b81;
    cursor: pointer;
    transition: 0.3s;
  }

  #startBtn:hover {
    transform: scale(1.1);
  }

  /* MAIN CONTENT */
  .container {
    padding: 50px 20px;
    animation: fadeIn 2s ease;
  }

  h1 {
    font-size: 2.8em;
    animation: glow 2s ease-in-out infinite alternate;
  }

  button {
    margin: 10px;
    padding: 12px 22px;
    border: none;
    border-radius: 25px;
    background: white;
    color: #ff6b81;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
  }

  button:hover {
    transform: scale(1.1);
    box-shadow: 0 0 15px white;
  }

  #messageBox {
    margin-top: 20px;
    font-size: 1.3em;
    min-height: 30px;
  }

  /* Cursor */
  #messageBox::after {
    content: "|";
    animation: blink 1s infinite;
  }

  /* Floating hearts */
  .floating-heart {
    position: fixed;
    bottom: -20px;
    font-size: 20px;
    animation: floatUp linear infinite;
  }

  /* Burst hearts */
  .burst-heart {
    position: fixed;
    font-size: 20px;
    pointer-events: none;
  }

  @keyframes gradientBG {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes glow {
    from { text-shadow: 0 0 10px #fff; }
    to { text-shadow: 0 0 20px #ff6b81; }
  }

  @keyframes floatUp {
    to {
      transform: translateY(-110vh);
      opacity: 0;
    }
  }

  @keyframes blink {
    0%, 50%, 100% { opacity: 1; }
    25%, 75% { opacity: 0; }
  }

</style>
</head>

<body>

<!-- INTRO -->
<div id="intro">
  <h1>For You ❤️</h1>
  <button id="startBtn" onclick="startSite()">Click to Start 💖</button>
</div>

<!-- MAIN CONTENT -->
<div class="container">
  <h1>Hi Love 💕</h1>
  <p>You unlocked my heart ❤️</p>

  <button onclick="showMessage()">💌 Surprise</button>
  <button onclick="createBurst(event)">💖 Send Love</button>

  <div id="messageBox"></div>
</div>

<script>
  /* START SCREEN */
  function startSite() {
    const intro = document.getElementById("intro");
    intro.style.opacity = "0";

    setTimeout(() => {
      intro.style.display = "none";
    }, 1000);

    createBurst();
  }

  /* TYPEWRITER MESSAGES */
  const messages = [
    "You are my everything ❤️",
    "I fall for you more every day 💕",
    "You make my world beautiful 🌍",
    "I’m so lucky to have you 🥰",
    "You + Me = Forever ♾️"
  ];

  function showMessage() {
    const box = document.getElementById("messageBox");
    const msg = messages[Math.floor(Math.random() * messages.length)];

    box.innerHTML = "";
    let i = 0;

    function typeWriter() {
      if (i < msg.length) {
        box.innerHTML += msg.charAt(i);
        i++;
        setTimeout(typeWriter, 40);
      }
    }

    typeWriter();
  }

  /* FLOATING HEARTS */
  function createHeart() {
    const heart = document.createElement("div");
    heart.className = "floating-heart";
    heart.innerText = "❤️";

    heart.style.left = Math.random() * 100 + "vw";
    heart.style.animationDuration = (3 + Math.random() * 3) + "s";

    document.body.appendChild(heart);

    setTimeout(() => heart.remove(), 6000);
  }

  setInterval(createHeart, 400);

  /* 💥 HEART BURST FROM BUTTON */
  function createBurst(event) {
    const x = event ? event.clientX : window.innerWidth / 2;
    const y = event ? event.clientY : window.innerHeight / 2;

    for (let i = 0; i < 25; i++) {
      const heart = document.createElement("div");
      heart.innerText = "❤️";
      heart.className = "burst-heart";

      heart.style.left = x + "px";
      heart.style.top = y + "px";

      document.body.appendChild(heart);

      const angle = Math.random() * 2 * Math.PI;
      const distance = 80 + Math.random() * 160;

      const dx = Math.cos(angle) * distance;
      const dy = Math.sin(angle) * distance;

      heart.animate([
        { transform: "translate(0,0)", opacity: 1 },
        { transform: `translate(${dx}px, ${dy}px)`, opacity: 0 }
      ], {
        duration: 900,
        easing: "ease-out"
      });

      setTimeout(() => heart.remove(), 900);
    }
  }

</script>

</body>
</html>
